{
  "manifest_version": 3,
  "name": "Pibblora – A Little Magic in Every Click",
  "version": "1.0.0",
  "description": "Cute pets, cursor trails, pastel themes, and a dreamy new tab.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": { 
    "default_popup": "popup.html", 
    "default_title": "Pibblora",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "search"],
  "web_accessible_resources": [
    {
      "resources": ["spider.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}